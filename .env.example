# Copy to .env and replace both secrets. Never commit real credentials.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
INGEST_API_KEY=replace-with-an-independent-long-random-key
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_DB=triagedock
POSTGRES_USER=triagedock
POSTGRES_PASSWORD=replace-with-a-strong-database-password
# Optional. Must be HTTPS. No notification requests are sent unless configured.
NOTIFICATION_WEBHOOK_URL=
