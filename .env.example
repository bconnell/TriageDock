# Copy to .env and replace the example secrets before startup.
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
INGEST_API_KEY=replace-with-a-distinct-random-api-key-of-at-least-32-characters
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
POSTGRES_DB=triagedock
POSTGRES_USER=triagedock
POSTGRES_PASSWORD=replace-with-a-unique-strong-database-secret
NOTIFICATION_WEBHOOK_URL=
# Optional independent high-entropy HMAC secret for verifying outbound webhook messages.
NOTIFICATION_WEBHOOK_SECRET=
SECURE_COOKIES=0
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
TRUST_PROXY_SSL_HEADER=0
INGEST_SHARED_KEY_ENABLED=1
# Set to 0 only after migrating monitors to source-scoped credentials.
# Required when NOTIFICATION_WEBHOOK_URL is set outside development.
NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=
